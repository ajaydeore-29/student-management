pipeline {
    agent {
        label "worker"
    }
    stages {
        stage('checkout') {
            steps {
                git 'https://github.com/ajaydeore-29/student-management.git'
                echo "clonning is successful"
            }
        }

        stage('build') {
            steps {
                sh '''
                mvn clean package
                '''
            }
        }
    }
}
