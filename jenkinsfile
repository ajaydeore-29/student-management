pipeline {
    agent {
        label 'worker'
    }

    tools {
        maven 'mvn'
    }

    environment {
        my_aws_cred = credentials('aws-cred')
    }

    stages {

        stage('Checkout') {
            steps {
                git 'https://github.com/ajaydeore-29/student-management.git'
                echo 'Cloning is successful'
            }
        }

        stage('Build') {
            steps {
                sh '''
                    mvn clean package
                '''
            }

            post {
                success {
                    archiveArtifacts artifacts: '**/target/*.war',
                    fingerprint: true
                }
            }
        }

        stage('Artifact to S3') {
            steps {
                sh '''
                    aws s3 cp target/*.war \
                    s3://ajay-bkt-jenkins-1234/Artifacts/student.war
                '''
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('sonar') {
                    sh '''
                        mvn sonar:sonar
                    '''
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 1, unit: 'HOURS') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }
    }
}