pipeline {
    agent {
        label "worker"
    }
    tools {
        maven 'mvn'
    }

    enviornment {
        my_aws_cred = credentials('aws-cred')
    }
    stages {
        stage('checkout') {
            steps {
                git 'https://github.com/ajaydeore-29/student-management.git'
                echo "clonning is successful"
            }
        }

        stage('build') {
            steps {
                sh '''
                mvn clean package
                '''
            }
        }

        stage('artifact to s3') {
            steps {
                sh 'aws s3 cp target/*.war s3://ajay-bkt-jenkins-1234/Artifacts/student.war'
            }
        }
    }
}
